// quickshell-chrome — niri keybinds
// Copy this `binds { … }` block into ~/.config/niri/config.kdl (replace your
// existing binds block, or merge the lines you want). Shell control goes
// through this config's IPC: `qs -c chrome ipc call <target> <fn>`.
// List everything with:  qs -c chrome ipc show

binds {
    // ── Shell (quickshell-chrome) ───────────────────────────────────────────
    Mod+D       { spawn-sh "qs -c chrome ipc call shell launcher"; }
    Mod+S       { spawn-sh "qs -c chrome ipc call shell quickSettings"; }
    Mod+N       { spawn-sh "qs -c chrome ipc call shell notifications"; }
    Mod+C       { spawn-sh "qs -c chrome ipc call shell calendar"; }
    Mod+Shift+N { spawn-sh "qs -c chrome ipc call shell dnd"; }
    Mod+Shift+I { spawn-sh "qs -c chrome ipc call shell nightLight"; }
    // Clipboard history (ChromeOS uses Search+V; Mod+V is floating here, so Mod+;)
    // Needs cliphist + a watcher: spawn-at-startup "sh" "-c" "wl-paste --watch cliphist store"
    Mod+Semicolon { spawn-sh "qs -c chrome ipc call shell clipboard"; }
    // Lock (needs swaylock) and the power menu (Lock / Sleep / Sign out / Restart / Off)
    Ctrl+Alt+L    { spawn-sh "qs -c chrome ipc call shell lock"; }
    Mod+Shift+Q   { spawn-sh "qs -c chrome ipc call shell power"; }

    // Base16 theme is driven by Flavours (~/.config/waybar/colors.css); the shell
    // re-themes live when you apply a scheme (random cycles through installed ones):
    Super+T     { spawn-sh "flavours random"; }
    // Wallpaper / screenshot aren't part of this shell — use niri's native ones
    // (below) or your own tools.

    // ── Personal ────────────────────────────────────────────────────────────
    Mod+Return       { spawn "footx"; }
    Mod+Shift+Return { spawn "footx" "-f"; }

    // ── Niri actions ────────────────────────────────────────────────────────
    Mod+Q { close-window; }
    Mod+Tab { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }

    // Float
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Workspace
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Move window / column
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }
    Mod+Ctrl+Home   { move-column-to-first; }
    Mod+Ctrl+End    { move-column-to-last; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Alt+Up    { move-column-to-workspace-up; }
    Alt+Down  { move-column-to-workspace-down; }
    Alt+Left  { consume-or-expel-window-left; }
    Alt+Right { consume-or-expel-window-right; }

    // Monitor
    Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Consume / expel
    Mod+BracketLeft  { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }

    // Size
    Mod+A { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Alt+F { toggle-windowed-fullscreen; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Shift+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Ctrl+Left  { focus-workspace-up; }
    Ctrl+Right { focus-workspace-down; }

    // Mouse
    Ctrl+WheelScrollDown     cooldown-ms=150 { focus-workspace-down; }
    Ctrl+WheelScrollUp       cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Alt+WheelScrollUp        cooldown-ms=150 { consume-or-expel-window-left; }
    Alt+WheelScrollDown      cooldown-ms=150 { consume-or-expel-window-right; }
    Mod+WheelScrollDown      cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-column-left; }
    Mod+Shift+WheelScrollDown { move-column-right; }
    Mod+Shift+WheelScrollUp   { move-column-left; }

    // ── Media / screenshot ──────────────────────────────────────────────────
    Print       { screenshot; }
    Mod+Print   { screenshot-screen; }
    Alt+Print   { screenshot-window; }
    // Screen recording (wf-recorder): region / full / stop
    Mod+Alt+R       { spawn-sh "qs -c chrome ipc call shell recordRegion"; }
    Mod+Alt+Shift+R { spawn-sh "qs -c chrome ipc call shell recordScreen"; }
    Mod+Alt+S       { spawn-sh "qs -c chrome ipc call shell recordStop"; }

    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "qs -c chrome ipc call audio up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "qs -c chrome ipc call audio down"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "qs -c chrome ipc call audio mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "qs -c chrome ipc call audio micMute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "qs -c chrome ipc call brightness up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "qs -c chrome ipc call brightness down"; }
}
